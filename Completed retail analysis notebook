        "]\n",
        "\n",
        "# Summarise each product.\n",
        "product_summary = (\n",
        "    top_product_rows\n",
        "    .groupby(\"StockCode\")\n",
        "    .agg(\n",
        "        Description=(\"Description\", lambda values: values.mode().iloc[0]),\n",
        "        GrossSalesValue=(\"LineValue\", \"sum\"),\n",
        "        Units=(\"Quantity\", \"sum\"),\n",
        "        InvoiceCount=(\"InvoiceNo\", \"nunique\"),\n",
        "        LargestLineValue=(\"LineValue\", \"max\")\n",
        "    )\n",
        ")\n",
        "\n",
        "# Calculate how much each product's largest line contributes.\n",
        "product_summary[\"LargestLinePercent\"] = (\n",
        "    product_summary[\"LargestLineValue\"]\n",
        "    / product_summary[\"GrossSalesValue\"]\n",
        "    * 100\n",
        ")\n",
        "\n",
        "product_summary.sort_values(\n",
        "    \"GrossSalesValue\", ascending=False\n",
        ").round(2)"
