      "source": [
        "# Define country_sales using the sensitivity_data\n",
        "country_sales = (\n",
        "    sensitivity_data\n",
        "    .groupby(\"Country\")[\"LineValue\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        ")"
      ],
