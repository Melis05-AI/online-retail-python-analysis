    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.ticker import StrMethodFormatter\n",
        "\n",
        "# 1. Download and load the raw dataset\n",
        "url = \"https://archive.ics.uci.edu/static/public/352/online+retail.zip\"\n",
        "retail_data = pd.read_excel(\n",
        "    __import__(\"io\").BytesIO(\n",
        "        __import__(\"zipfile\").ZipFile(\n",
        "            __import__(\"io\").BytesIO(\n",
        "                __import__(\"requests\").get(url).content\n",
        "            )\n",
        "        ).read(\"Online Retail.xlsx\")\n",
        "    )\n",
        ")\n",
        "\n",
        "# 2. Filter cancellation rows and build positive sales dataset\n",
        "is_cancellation = retail_data[\"InvoiceNo\"].astype(str).str.upper().str.startswith(\"C\", na=False)\n",
        "sales_mask = (retail_data[\"Quantity\"] > 0) & (retail_data[\"UnitPrice\"] > 0) & (~is_cancellation)\n",
        "sales_data = retail_data.loc[sales_mask].copy()\n",
        "sales_data[\"LineValue\"] = sales_data[\"Quantity\"] * sales_data[\"UnitPrice\"]\n",
        "\n",
        "# 3. Standardize product codes, apply merchandise exclusions and drop duplicate rows\n",
        "normalised_codes = sales_data[\"StockCode\"].astype(str).str.strip().str.upper()\n",
        "excluded_codes = [\"AMAZONFEE\", \"B\", \"BANK CHARGES\", \"DOT\", \"M\", \"POST\", \"S\"]\n",
        "exclude_from_merchandise = normalised_codes.isin(excluded_codes)\n",
        "merchandise_data = sales_data.loc[~exclude_from_merchandise].copy()\n",
        "clean_merchandise = merchandise_data.drop_duplicates().copy()\n",
        "\n",
        "# 4. Filter data to include only records prior to Dec 2011 and apply sensitivity drops\n",
        "monthly_chart_data = clean_merchandise[clean_merchandise[\"InvoiceDate\"] < \"2011-12-01\"].copy()\n",
        "flagged_row_labels = [61619, 222680]\n",
        "sensitivity_data = monthly_chart_data.drop(index=flagged_row_labels, errors='ignore')\n",
        "\n",
        "# 5. Aggregate sales to define country_sales\n",
        "country_sales = (\n",
        "    sensitivity_data\n",
        "    .groupby(\"Country\")[\"LineValue\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "# 6. Plot the top 10 international markets\n",
