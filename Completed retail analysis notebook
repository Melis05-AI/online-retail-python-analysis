    {
      "cell_type": "markdown",
      "source": [
        "## 8. Customer analysis\n",
        "\n",
        "Measure customer-ID coverage, then analyse identified customers'\n",
        "invoice counts, gross sales values, and average invoice values.\n",
        "\n",
        "Calculate the percentage of identified customers with at least two\n",
        "included invoices and the top 10 customers' share of identified sales.\n",
        "\n",
        "This analysis uses the sensitivity view for December 2010–November 2011.\n",
        "Missing customer IDs are excluded from individual-customer calculations.\n",
        "\n",
        "Multiple invoices do not establish customer retention, and gross sales\n",
        "value does not measure profit."
      ],
      "metadata": {
        "id": "C005mgOF6gl8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Identify rows with a recorded customer ID.\n",
        "has_customer_id = sensitivity_data[\"CustomerID\"].notna()\n",
        "\n",
        "# Create a separate table for customer analysis.\n",
        "customer_data = sensitivity_data.loc[has_customer_id].copy()\n",
        "\n",
        "print(\"Rows with customer IDs:\", len(customer_data))\n",
        "print(\"Rows without customer IDs:\", (~has_customer_id).sum())\n",
        "print(\"Distinct recorded customers:\", customer_data[\"CustomerID\"].nunique())\n",
        "\n",
        "# Calculate the percentage of sales value linked to a customer ID.\n",
        "identified_value = customer_data[\"LineValue\"].sum()\n",
        "total_value = sensitivity_data[\"LineValue\"].sum()\n",
        "\n",
        "print(\n",
        "    f\"Sales value linked to customer IDs: \"\n",
        "    f\"{identified_value / total_value * 100:.2f}%\"\n",
        ")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "gFwg5BlRvYSy",
        "outputId": "2cd60033-47bb-4f0a-ed20-d8bae2dfbc72"
      },
      "execution_count": 47,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Rows with customer IDs: 374317\n",
            "Rows without customer IDs: 123635\n",
            "Distinct recorded customers: 4292\n",
            "Sales value linked to customer IDs: 85.21%\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Summarise each identified customer's recorded purchases.\n",
        "customer_summary = (\n",
        "    customer_data\n",
        "    .groupby(\"CustomerID\")\n",
        "    .agg(\n",
        "        InvoiceCount=(\"InvoiceNo\", \"nunique\"),\n",
        "        GrossSalesValue=(\"LineValue\", \"sum\"),\n",
        "        FirstPurchase=(\"InvoiceDate\", \"min\"),\n",
        "        LastPurchase=(\"InvoiceDate\", \"max\")\n",
        "    )\n",
        ")\n",
        "\n",
        "# Calculate average included value per distinct invoice.\n",
        "customer_summary[\"AverageInvoiceValue\"] = (\n",
        "    customer_summary[\"GrossSalesValue\"]\n",
        "    / customer_summary[\"InvoiceCount\"]\n",
        ")\n",
        "\n",
        "# Display the 10 customers with the highest gross sales value.\n",
        "customer_summary.sort_values(\n",
        "    \"GrossSalesValue\", ascending=False\n",
        ").head(10).round(2)"
      ],
